    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@google/genai": "^2.24.0"
  }
}
